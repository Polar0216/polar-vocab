{
  "name": "polar-vocab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && npm run typecheck:desktop",
    "typecheck:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "desktop:build": "node apps/desktop/scripts/build.mjs",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:dev": "npm run desktop:runtime && npm run desktop:build && electron apps/desktop",
    "desktop:package": "npm run desktop:runtime && npm run desktop:build && electron-builder --projectDir apps/desktop --config electron-builder.json --win portable --x64 --publish never",
    "test:desktop": "vitest run --config apps/desktop/vitest.config.ts",
    "test:desktop:e2e": "playwright test --config apps/desktop/playwright.config.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "build:root": "node scripts/build-root.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:dist": "node scripts/check-dist.mjs /polar-vocab/",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:public-index": "node scripts/check-public-index.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:pages && npm run check:dist && npm run check:secrets"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "read-excel-file": "9.3.12",
    "ts-fsrs": "5.4.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-window": "7.4.1"
  }
}
